# LLM-as-judge panel -- all three models are served by the Thoth gateway and
# called through the standard `openai` SDK against ${THOTH_BASE_URL}/v1
THOTH_BASE_URL=http://100.106.43.6:8090/api/mcp
THOTH_API_KEY=<your token>

# Hosted NVIDIA RAG stack on the RTX6000 cluster. Two separate services:
#   query server  (8081) -- /v1/generate, /v1/search, /v1/configuration
#   ingest server (8082) -- /v1/collections, /v1/documents, /v1/status
NVIDIA_RAG_BASE_URL=http://rpgpu127.balinese-monster.ts.net:8081
NVIDIA_INGEST_BASE_URL=http://rpgpu127.balinese-monster.ts.net:8082

# Second Node if Node 1 down or fell of bus
# NVIDIA_RAG_BASE_URL=http://rpgpu128.balinese-monster.ts.net:8081
# NVIDIA_INGEST_BASE_URL=http://rpgpu128.balinese-monster.ts.net:8082

# H200 cluster if Node 1 and 2 down or fell of bus
# NVIDIA_RAG_BASE_URL=http://hgpu122.ntt.mtailabs.ai:8081/
# NVIDIA_INGEST_BASE_URL=http://hgpu122.ntt.mtailabs.ai:8082/

NVIDIA_RAG_COLLECTION=parliament_hansard_eval
# 'vl' (multimodal, llama-nemotron-embed-vl-1b-v2) or 'text'. NOTE: the vl
# profile does not support the reranker or summaries -- see datasets/README.md.
NVIDIA_RAG_EMBEDDING_PROFILE=text
NVIDIA_RAG_API_KEY=

# TanyaParlimen production RAG.
#
# NOT YET KNOWN. The host below is a placeholder and does not resolve — the
# service was to sit on the RTX6000 cluster, which is down, so neither its
# endpoint nor its collection has been confirmed. Replace before use; the
# adapter refuses to construct without a base URL rather than running a whole
# eval against nothing.
TANYAPARLIMEN_BASE_URL=            # e.g. https://<host>/  — unconfirmed
TANYAPARLIMEN_API_KEY=
