{
  "judge": {
    "base_url_env": "THOTH_BASE_URL",
    "api_key_env": "THOTH_API_KEY",
    "context_top_k": 5,
    "flag_spread_threshold": 2,
    "models": [
      {"id": "glm-5.2",      "label": "GLM-5.2",      "input_cost_per_1k": 0.0, "output_cost_per_1k": 0.0},
      {"id": "qwen3.5-397b", "label": "Qwen3.5-397B", "input_cost_per_1k": 0.0, "output_cost_per_1k": 0.0},
      {"id": "kimi-k2.6",    "label": "Kimi-K2.6",    "input_cost_per_1k": 0.0, "output_cost_per_1k": 0.0}
    ]
  },
  "metrics": {
    "k_values": [1, 3, 5, 10],
    "hallucination_threshold": 3,
    "pass_threshold": 4
  },
  "adapters": {
    "nvidia": {
      "options": {
        "collection": "parliament_hansard_eval",
        "embedding_profile": "text",
        "top_k": 5,
        "config_path": "/v1/configuration",
        "collections_path": "/v1/collections",
        "sitting_fields": ["metadata.sitting_id", "metadata.source_id", "document_name"],
        "page_fields": ["metadata.page_number", "content_metadata.page_number"],
        "dewan_fields": ["metadata.dewan", "content_metadata.dewan"],
        "session_date_fields": ["metadata.session_date", "content_metadata.session_date"],
        "input_cost_per_1k": 0.0,
        "output_cost_per_1k": 0.0
      }
    },
    "tanyaparlimen": {
      "options": {
        "top_k": 5,
        "sitting_fields": ["sitting_id", "document_id"],
        "page_fields": ["page", "ms"]
      }
    }
  }
}
